{
  "name": "@bookorbit/novel-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Runs LNReader light novel sources for BookOrbit Web Serials in their own container.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.13",
    "htmlparser2": "^10.0.0",
    "protobufjs": "^7.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
